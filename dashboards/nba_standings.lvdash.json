{
  "datasets": [
    {
      "name": "standings",
      "displayName": "Standings",
      "queryLines": [
        "SELECT season, snapshot_date, league_rank, conference, conference_rank, team, record, ",
        "       wins, losses, win_pct, home_win_pct, road_win_pct, ",
        "       points_pg, opp_points_pg, diff_points_pg, last10, streak ",
        "FROM team_standings_current ",
        "ORDER BY win_pct DESC, diff_points_pg DESC"
      ]
    },
    {
      "name": "summary",
      "displayName": "Summary",
      "queryLines": [
        "SELECT max_by(team, win_pct) AS best_team, ",
        "       max(win_pct) AS best_win_pct, ",
        "       max(season) AS season, ",
        "       max(snapshot_date) AS as_of ",
        "FROM team_standings_current"
      ]
    }
  ],
  "pages": [
    {
      "name": "standings_page",
      "displayName": "Standings",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "## NBA standings\n",
                "Source: nba_api `leaguestandingsv3` -> bronze -> silver -> gold"
              ]
            }
          },
          "position": { "x": 0, "y": 0, "width": 6, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_best_team",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "summary",
                  "fields": [{ "name": "best_team", "expression": "`best_team`" }],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "best_team", "displayName": "Best record" }
              },
              "frame": { "showTitle": true, "title": "Best record" }
            }
          },
          "position": { "x": 0, "y": 2, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_best_win_pct",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "summary",
                  "fields": [{ "name": "best_win_pct", "expression": "`best_win_pct`" }],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "best_win_pct", "displayName": "Best win %" }
              },
              "frame": { "showTitle": true, "title": "Best win %" }
            }
          },
          "position": { "x": 2, "y": 2, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_as_of",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "summary",
                  "fields": [{ "name": "as_of", "expression": "`as_of`" }],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "as_of", "displayName": "Data as of" }
              },
              "frame": { "showTitle": true, "title": "Data as of" }
            }
          },
          "position": { "x": 4, "y": 2, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "bar_win_pct",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "standings",
                  "fields": [
                    { "name": "team", "expression": "`team`" },
                    { "name": "win_pct", "expression": "`win_pct`" },
                    { "name": "conference", "expression": "`conference`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "team",
                  "scale": { "type": "categorical", "sort": { "by": "y-reversed" } },
                  "displayName": "Team"
                },
                "y": {
                  "fieldName": "win_pct",
                  "scale": { "type": "quantitative" },
                  "displayName": "Win %"
                },
                "color": {
                  "fieldName": "conference",
                  "scale": { "type": "categorical" },
                  "displayName": "Conference"
                }
              },
              "frame": { "showTitle": true, "title": "Win % by team" }
            }
          },
          "position": { "x": 0, "y": 5, "width": 6, "height": 8 }
        },
        {
          "widget": {
            "name": "table_standings",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "standings",
                  "fields": [
                    { "name": "league_rank", "expression": "`league_rank`" },
                    { "name": "team", "expression": "`team`" },
                    { "name": "conference", "expression": "`conference`" },
                    { "name": "conference_rank", "expression": "`conference_rank`" },
                    { "name": "record", "expression": "`record`" },
                    { "name": "win_pct", "expression": "`win_pct`" },
                    { "name": "home_win_pct", "expression": "`home_win_pct`" },
                    { "name": "road_win_pct", "expression": "`road_win_pct`" },
                    { "name": "diff_points_pg", "expression": "`diff_points_pg`" },
                    { "name": "last10", "expression": "`last10`" },
                    { "name": "streak", "expression": "`streak`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "league_rank", "displayName": "#" },
                  { "fieldName": "team", "displayName": "Team" },
                  { "fieldName": "conference", "displayName": "Conf" },
                  { "fieldName": "conference_rank", "displayName": "Conf rank" },
                  { "fieldName": "record", "displayName": "W-L" },
                  { "fieldName": "win_pct", "displayName": "Win %" },
                  { "fieldName": "home_win_pct", "displayName": "Home %" },
                  { "fieldName": "road_win_pct", "displayName": "Road %" },
                  { "fieldName": "diff_points_pg", "displayName": "Pt diff / g" },
                  { "fieldName": "last10", "displayName": "Last 10" },
                  { "fieldName": "streak", "displayName": "Streak" }
                ]
              },
              "frame": { "showTitle": true, "title": "Standings" }
            }
          },
          "position": { "x": 0, "y": 13, "width": 6, "height": 12 }
        }
      ]
    }
  ]
}
